#Add paths to your data! Phenotypes and the corresponding meta data are required, proteins, metabolites and
#genomic variants are optional.
# Data sources (e.g. phenotypes, proteins, metabolites, genomic variants), each with its own meta data
# file. Provide comma-separated lists of equal length, one entry per data source.
# Optional: if set, this is prepended to any relative path in DATA_PATHS/DATA_META_PATHS,
# so you only need to provide file names there.
DATA_ROOT=/nfs/scratch/DyHealthNet/chris_summary_data
DATA_PATHS=fully_simulated/phenotypes_filtered_index_renamed.csv,fully_simulated/proteins.csv,fully_simulated/metabolites.csv
DATA_META_PATHS=phenotypes/pheno_meta_filtered.tsv,proteins/CHRIS_somalogic_descriptive_statistic.tsv,metabolites/CHRIS_biocristes7500SumStats.tsv
DATA_LABEL_COLUMNS=label,protein_id,analyte_name
# Specify the type column or simply the type of each data source
DATA_TYPE_COLUMNS=type,continuous,continuous
# Optional, per data source: display name / description / cross-reference columns for
# the nodes table (not used for scoring). Leave an entry empty to skip it for that source.
DATA_DP_NAME_COLUMNS=snomed_term,UniProt,
DATA_DESCRIPTION_COLUMNS=description,Target,biochemical_name
DATA_XREF_COLUMNS=snomed_id,UniProt,hmdb_id
# Group column (or literal group name) per source - matches backend_django's
# DATA_GROUP_COLUMNS so the rebuilt nodes table's node_group lines up with what
# GetNetworkView/GetGroupNetworkView and the contexts feature expect.
DATA_GROUP_COLUMNS=phenotype,protein,metabolite

# Other options
#Optional: Here you can add a JSON file that maps your categorical variables encoded by integers to the actual categories.
VAR_LABEL_MAPPING=None
#Adjust the path where to save the calculated association scores for your data!
PARAMETRIC_EDGES_PATH=/nfs/home/students/b.rehor/masterthesis/fresh_dhn_setup/data/CHRIS_parametric_scores.csv
NONPARAMETRIC_EDGES_PATH=/nfs/home/students/b.rehor/masterthesis/fresh_dhn_setup/data/CHRIS_nonparametric_scores.csv
DATA_DIR=/nfs/home/students/b.rehor/masterthesis/fresh_dhn_setup/data
#Number of Contexts a User is allowed to create and least number of patients required to create a context
MAX_CONTEXT_PER_USER=5
#For privay protection, if less this amount of people are in a group for visualization on the data overview page
#no data will be shown or send to the frontend
CRITICAL_NUMBER=5

# Score calculation settings
#Patient/ Participent index column of your data tables. Adjust accordingly!
PATIENT_ID_COLUMN=Patient ID
#Adjust according to your preferences!
NUMBER_OF_WORKERS=16
TEST_TYPE=all
